{
  "name": "coaching-therapy-react",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/export-routes.mjs",
    "build:production": "node scripts/build-production.mjs",
    "dev:worker": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply coaching-therapy-applications --local",
    "db:migrate:remote": "wrangler d1 migrations apply coaching-therapy-applications --remote",
    "deploy:cloudflare": "pnpm build:production && wrangler deploy",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "vite": "7.2.2",
    "wrangler": "^4.161.0"
  }
}
