{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "coaching-therapy",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-13",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist", "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "d1_databases": [{
    "binding": "DB", "database_name": "coaching-therapy-applications",
    "database_id": "4a1ea1b5-6e1c-469d-9708-3125a9d5f108",
    "migrations_dir": "migrations"
  }],
  "vars": {
    "SITE_ORIGIN": "https://coaching-therapy.coaching-therapy-react.workers.dev",
    "NOTIFICATION_EMAIL": "souta.sumii@gmail.com",
    "MAIL_FROM": "こころのプライベートサロン <noreply@coaching-therapy.jp>"
  },
  "triggers": { "crons": ["*/10 * * * *"] },
  "observability": { "enabled": false }
}
