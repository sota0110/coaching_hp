block-paragraph"},"children":["専門的な知識を学んできた私自身も、",{"tag":"br","attrs":{},"children":[]},"実際の子育てでは戸惑うことが",{"tag":"br","attrs":{},"children":[]},"たくさんありました。"]},{"tag":"p","attrs":{"class":"wp-block-paragraph"},"children":["子どものことを大切に思うからこそ悩み、",{"tag":"br","attrs":{},"children":[]},"思うようにいかない自分に",{"tag":"br","attrs":{},"children":[]},"落ち込むこともありました。"]},{"tag":"p","attrs":{"class":"wp-block-paragraph"},"children":["そんな経験を通して実感したのは、",{"tag":"br","attrs":{},"children":[]},"子育てに必要なのは",{"tag":"br","attrs":{},"children":[]},"知識や情報だけではないということ。"]},{"tag":"p","attrs":{"class":"wp-block-paragraph"},"children":["安心して気持ちを話せる",{"tag":"br","attrs":{},"children":[]},"場所があること。",{"tag":"br","attrs":{},"children":[]},"誰かとつながり、",{"tag":"br","attrs":{},"children":[]},"一人で抱え込まなくていいと思えること。"]},{"tag":"p","attrs":{"class":"wp-block-paragraph"},"children":["それが、子育てをする人にとって",{"tag":"br","attrs":{},"children":[]},"大きな支えになるのだと感じました。"]},{"tag":"h2","attrs":{"class":"wp-block-heading"},"children":["「子育てをひとりにしない」",{"tag":"br","attrs":{},"children":[]},"  居場所づくり"]},{"tag":"p","attrs":{"class":"wp-block-paragraph"},"children":["東日本大震災をきっかけに、",{"tag":"br","attrs":{},"children":[]},"2011年、ふれあい子育てサロン「スイミー」を",{"tag":"br","attrs":{},"children":[]},"スタートしました。"]},{"tag":"p","attrs":{"class":"wp-block-paragraph"},"children":["自分と同じように、",{"tag":"br","attrs":{},"children":[]},"孤独な子育てに悩むママをなくしたい。"]},{"tag":"p","attrs":{"class":"wp-block-paragraph"},"children":["そんな思いから始まった小さな活動は、",{"tag":"br","attrs":{},"children":[]},"たくさんの方とのご縁に支えられ、",{"tag":"br","attrs":{},"children":[]},"2016年にはNPO法人化。"]},{"tag":"p","attrs":{"class":"wp-block-paragraph"},"children":["「子育てをひとりにしない」を大切に、",{"tag":"br","attrs":{},"children":[]},"親子が安心して過ごせる居場所づくりや、",{"tag":"br","attrs":{},"children":[]},"ママ同士がつながる機会をつくり続けてきました。"]},{"tag":"p","attrs":{"class":"wp-block-paragraph"},"children":["活動は少しずつ広がり、",{"tag":"br","attrs":{},"children":[]},"コロナ禍前には年間2,000組以上の親子が",{"tag":"br","attrs":{},"children":[]},"参加するサロンへと成長しました。"]},{"tag":"p","attrs":{"class":"wp-block-paragraph"},"children":["これまでに出会った親子は1万組以上。"]},{"tag":"p","attrs":{"class":"wp-block-paragraph"},"children":["たくさんのママたちの声に",{"tag":"br","attrs":{},"children":[]},"耳を傾けるなかで、子育ての悩みだけでなく、",{"tag":"br","attrs":{},"children":[]},"自分自身の気持ちを後回しにして",{"tag":"br","attrs":{},"children":[]},"頑張っている姿にも、数多く触れてきました。"]},{"tag":"p","attrs":{"class":"wp-block-paragraph"},"children":["子どものために頑張りたい。",{"tag":"br","attrs":{},"children":[]},"家族を大切にしたい。",{"tag":"br","attrs":{},"children":[]},"でも、自分自身にも余裕が",{"tag":"br","attrs":{},"children":[]},"なくなってしまう。"]},{"tag":"p","attrs":{"class":"wp-block-paragraph"},"children":["そんなママたちの姿は、",{"tag":"br","attrs":{},"children":[]},"かつての自分自身とも重なりました。"]},{"tag":"p","attrs":{"class":"wp-block-paragraph"},"children":["だからこそ、",{"tag":"br","attrs":{},"children":[]},"家族を大切にするのと同じように、",{"tag":"br","attrs":{},"children":[]},"自分の気持ちも大切にしてほしい。"]},{"tag":"p","attrs":{"class":"wp-block-paragraph"},"children":["その思いが、私の活動を",{"tag":"br","attrs":{},"children":[]},"さらに深めていくことになりました。"]},{"tag":"h2","attrs":{"class":"wp-block-heading"},"children":["自分自身と向き合うことで、",{"tag":"br","attrs":{},"children":[]},"見えてきたこと"]},{"tag":"p","attrs":{"class":"wp-block-paragraph"},"children":["子育て支援を続けながら、",{"tag":"br","attrs":{},"children":[]},"私自身も心理学やコーチング、",{"tag":"br","attrs":{},"children":[]},"セラピーについて学びを深めてきました。"]},{"tag":"p","attrs":{"class":"wp-block-paragraph"},"children":["学びを通して気づいたのは、",{"tag":"br","attrs":{},"children":[]},"目の前の出来事そのものだけでなく、",{"tag":"br","attrs":{},"children":[]},"それを自分がどう受け止めているかによって、",{"tag":"br","attrs":{},"children":[]},"気持ちや行動、人との関わり方が",{"tag":"br","attrs":{},"children":[]},"変わっていくということです。"]},{"tag":"p","attrs":{"class":"wp-block-paragraph"},"children":["「こうしなければ」",{"tag":"br","attrs":{},"children":[]},"「私が頑張らなくては」"]},{"tag":"p","attrs":{"class":"wp-block-paragraph"},"children":["そんな思いにとらわれていた",{"tag":"br","attrs":{},"children":[]},"自分を見つめ直し、自分の気持ちを",{"tag":"br","attrs":{},"children":[]},"受け止めることの大切さを知りました。"]},{"tag":"p","attrs":{"class":"wp-block-paragraph"},"children":["自分の内面と向き合うことは、",{"tag":"br","attrs":{},"children":[]},"決して自分を責めたり、",{"tag":"br","attrs":{},"children":[]},"無理に変えたりすることではありません。"]},{"tag":"p","attrs":{"class":"wp-block-paragraph"},"children":["今の自分の気持ちに気づき、",{"tag":"br","attrs":{},"children":[]},"自分を理解し、",{"tag":"br","attrs":{},"children":[]},"自分に合った選択をしていくこと。"]},{"tag":"p","attrs":{"class":"wp-block-paragraph"},"children":["その積み重ねが、",{"tag":"br","attrs":{},"children":[]},"日々の暮らしや人との関係を",{"tag":"br","attrs":{},"children":[]},"少しずつ変えていくのだと、",{"tag":"br","attrs":{},"children":[]},"私自身の経験から感じています。"]},{"tag":"h2","attrs":{"class":"wp-block-heading"},"children":["一人ひとりが、自分らしい",{"tag":"br","attrs":{},"children":[]},"答えを見つけられるように"]},{"tag":"p","attrs":{"class":"wp-block-paragraph"},"children":["これまでの福祉の経験、",{"tag":"br","attrs":{},"children":[]},"15年以上にわたる子育て支援、",{"tag":"br","attrs":{},"children":[]},"そして心理学・コーチング・",{"tag":"br","attrs":{},"children":[]},"セラピーの学び。"]},{"tag":"p","attrs":{"class":"wp-block-paragraph"},"children":["それらを活かし、現在は",{"tag":"br","attrs":{},"children":[]},"プライベートコーチング相談や",{"tag":"br","attrs":{},"children":[]},"「自分を整え、人を癒す」",{"tag":"br","attrs":{},"children":[]},"コーチング＆セラピー講座を",{"tag":"br","attrs":{},"children":[]},"行っています。"]},{"tag":"p","attrs":{"class":"wp-block-paragraph"},"children":["相談の時間で大切にしているのは、",{"tag":"br","attrs":{},"children":[]},"私が答えを教えることではなく、",{"tag":"br","attrs":{},"children":[]},"その方自身が自分の気持ちに気づき、",{"tag":"br","attrs":{},"children":[]},"本当に大切にしたいことを",{"tag":"br","attrs":{},"children":[]},"見つけていくことです。"]},{"tag":"p","attrs":{"class":"wp-block-paragraph"},"children":["子育てのこと、",{"tag":"br","attrs":{},"children":[]},"夫婦や家族との関係、仕事、",{"tag":"br","attrs":{},"children":[]},"これからの人生。"]},{"tag":"p","attrs":{"class":"wp-block-paragraph"},"children":["人それぞれに悩みや思いがあり、",{"tag":"br","attrs":{},"children":[]},"必要なサポートも違います。"]},{"tag":"p","attrs":{"class":"wp-block-paragraph"},"children":["だからこそ、",{"tag":"br","attrs":{},"children":[]},"一人ひとりのお話を丁寧に伺い、",{"tag":"br","attrs":{},"children":[]},"その方のペースを大切にしながら、",{"tag":"br","attrs":{},"children":[]},"一緒に考えていくことを心がけています。"]},{"tag":"p","attrs":{"class":"wp-block-paragraph"},"children":["大きな悩みがあるときだけでなく、",{"tag":"br","attrs":{},"children":[]},"少し立ち止まって自分を見つめたいときにも、",{"tag":"br","attrs":{},"children":[]},"気軽に心を整えられる場所でありたい。"]},{"tag":"p","attrs":{"class":"wp-block-paragraph"},"children":["そんな思いで、日々活動しています。"]},{"tag":"h2","attrs":{"class":"wp-block-heading"},"children":["私自身の暮らしの中でも、",{"tag":"br","attrs":{},"children":[]},"大切にしていること"]},{"tag":"p","attrs":{"class":"wp-block-paragraph"},"children":["私が20年以上続けている習慣のひとつに、",{"tag":"br","attrs":{},"children":[]},"朝の散歩と瞑想があります。"]},{"tag":"p","attrs":{"class":"wp-block-paragraph"},"children":["自然の中を歩き、",{"tag":"br","attrs":{},"children":[]},"自分の心と静かに向き合う時間は、",{"tag":"br","attrs":{},"children":[]},"日々の忙しさから少し離れ、",{"tag":"br","attrs":{},"children":[]},"自分自身を整える大切なひとときです。"]},{"tag":"p","attrs":{"class":"wp-block-paragraph"},"children":["また、寝る前には、",{"tag":"br","attrs":{},"children":[]},"その日に感謝したことを",{"tag":"br","attrs":{},"children":[]},"3つ思い浮かべるようにしています。"]},{"tag":"p","attrs":{"class":"wp-block-paragraph"},"children":["特別な出来事がなくても、",{"tag":"br","attrs":{},"children":[]},"日常の中には、すでにある幸せや",{"tag":"br","attrs":{},"children":[]},"大切なものがたくさんあります。"]},{"tag":"p","attrs":{"class":"wp-block-paragraph"},"children":["忙しい毎日の中で、",{"tag":"br","attrs":{},"children":[]},"つい見過ごしてしまう",{"tag":"br","attrs":{},"children":[]},"小さな幸せに気づくこと。"]},{"tag":"p","attrs":{"class":"wp-block-paragraph"},"children":["それも、自分を大切にすることの",{"tag":"br","attrs":{},"children":[]},"ひとつだと思っています。"]},{"tag":"p","attrs":{"class":"wp-block-paragraph"},"children":["これからも、私自身が学び、",{"tag":"br","attrs":{},"children":[]},"実践しながら、一人ひとりが",{"tag":"br","attrs":{},"children":[]},"自分らしい幸せを見つけていく",{"tag":"br","attrs":{},"children":[]},"お手伝いをしていけたら嬉しいです。"]},{"tag":"h3","attrs":{"class":"wp-block-heading"},"children":["主な資格・経歴"]},{"tag":"ul","attrs":{"class":"wp-block-list"},"children":[{"tag":"li","attrs":{},