ll is-resized is-style-vk-image-wave02"},"children":[{"tag":"img","attrs":{"decoding":"async","width":"512","height":"512","src":"/assets/d6bb5618d8f6737b.jpg","alt":"","class":"wp-image-41","style":"object-fit:cover;width:20px;height:20px"},"children":[]}]},{"tag":"p","attrs":{"class":"wp-block-paragraph"},"children":[{"tag":"br","attrs":{},"children":[]},{"tag":"strong","attrs":{},"children":["こんなことありませんか？"]},{"tag":"br","attrs":{},"children":[]},"・家族に優しくしたいのに、ついイライラしてしまう",{"tag":"br","attrs":{},"children":[]},"・いつも周りを優先して、自分のことを後回しにしてしまう",{"tag":"br","attrs":{},"children":[]},"・人の言葉や反応に振り回されてしまう",{"tag":"br","attrs":{},"children":[]},"・「私は本当はどうしたいんだろう？」と思うことがある",{"tag":"br","attrs":{},"children":[]},"・頑張っているのに、心が満たされない",{"tag":"br","attrs":{},"children":[]},"・自分に自信が持てない",{"tag":"br","attrs":{},"children":[]},"・子育てが一段落して、自分の人生について考えたい",{"tag":"br","attrs":{},"children":[]},"・これからの人生を、もっと自分らしく生きたい",{"tag":"br","attrs":{},"children":[]},"・悩みはあるけど、誰かに相談するほどなのかわからない",{"tag":"br","attrs":{},"children":[]},"・自分で自分の心を整える力を身につけたい",{"tag":"br","attrs":{},"children":[]},"もし一つでも「これ、私のことかも」と感じるものがあったら",{"tag":"br","attrs":{},"children":[]},"少し立ち止まって、自分の心に目を向けてみませんか？"]},{"tag":"figure","attrs":{"class":"wp-block-image size-full is-resized is-style-vk-image-wave02"},"children":[{"tag":"img","attrs":{"decoding":"async","width":"512","height":"512","src":"/assets/d6bb5618d8f6737b.jpg","alt":"","class":"wp-image-41","style":"object-fit:cover;width:20px;height:20px"},"children":[]}]},{"tag":"p","attrs":{"class":"wp-block-paragraph"},"children":[{"tag":"strong","attrs":{},"children":["うまく話せなくても、大丈夫です。"]},{"tag":"br","attrs":{},"children":[]},"「何をはなしたらいいのかわからない」",{"tag":"br","attrs":{},"children":[]},"「自分の気持ちをうまく言葉にできない」",{"tag":"br","attrs":{},"children":[]},"そんな方も、どうぞ安心してください。",{"tag":"br","attrs":{},"children":[]},"まとまってなくても大丈夫。",{"tag":"br","attrs":{},"children":[]},"涙がでても大丈夫。",{"tag":"br","attrs":{},"children":[]},"言葉にならなくても大丈夫。",{"tag":"br","attrs":{},"children":[]},"話しているうちに、",{"tag":"br","attrs":{},"children":[]},"「私、本当はこんなふうに感じていたんだ」",{"tag":"br","attrs":{},"children":[]},"と、自分でも気づいていなかった気持ちに気づくことがあります。",{"tag":"br","attrs":{},"children":[]},"私は答えを一方的にお伝えするのではなく",{"tag":"br","attrs":{},"children":[]},"あなたのお話を丁寧に聴きながら",{"tag":"br","attrs":{},"children":[]},"一緒に心の中を整理していきます。"]},{"tag":"details","attrs":{"class":"wp-block-details is-layout-flow wp-block-details-is-layout-flow"},"children":[{"tag":"summary","attrs":{},"children":["続きを読む"]},{"tag":"p","attrs":{"class":"wp-block-paragraph"},"children":[{"tag":"strong","attrs":{},"children":["「変わらなきゃ」と思わなくても大丈夫。"]},{"tag":"br","attrs":{},"children":[]},"コーチングというと「目標を決めて、前向きになって、行動する」",{"tag":"br","attrs":{},"children":[]},"そんなイメージがあるかもしれません。",{"tag":"br","attrs":{},"children":[]},"でも、私が大切にしているのは",{"tag":"br","attrs":{},"children":[]},"まず「自分を知ること」です。",{"tag":"br","attrs":{},"children":[]},"今、私は何を感じているんだろう。",{"tag":"br","attrs":{},"children":[]},"本当は何を望んでいるのだろう。",{"tag":"br","attrs":{},"children":[]},"何を大切のしたいんだろう。",{"tag":"br","attrs":{},"children":[]},"自分の本当の想いに気づいていくと",{"tag":"br","attrs":{},"children":[]},{"tag":"strong","attrs":{},"children":["少しづつ心が整い、気づけば考え方や行動も"]},{"tag":"br","attrs":{},"children":[]},{"tag":"strong","attrs":{},"children":["自然と変わっていきます。"]},{"tag":"br","attrs":{},"children":[]},"だから、無理に変わろうとしなくて大丈夫。",{"tag":"br","attrs":{},"children":[]},"まずは今の自分を知ることから。"]},{"tag":"hr","attrs":{"class":"wp-block-separator has-alpha-channel-opacity"},"children":[]},{"tag":"p","attrs":{"class":"wp-block-paragraph"},"children":[{"tag":"strong","attrs":{},"children":["自分を整えると、見える景色も変わっていく"]},{"tag":"br","attrs":{},"children":[]},"心が整うと",{"tag":"br","attrs":{},"children":[]},"同じ出来事でも、見え方が変わることがあります。",{"tag":"br","attrs":{},"children":[]},"見えるものが変わると、感じ方が変わる。",{"tag":"br","attrs":{},"children":[]},"感じ方が変わると、選ぶ行動が変わる。",{"tag":"br","attrs":{},"children":[]},"そして少しずつ現実も変わっていく。",{"tag":"br","attrs":{},"children":[]},"私はこれまで15年以上にわたり",{"tag":"br","attrs":{},"children":[]},"NPO法人　ふれあい子育てサロン　スイミーを通じて",{"tag":"br","attrs":{},"children":[]},"沢山の親子と出会ってきました。",{"tag":"br","attrs":{},"children":[]},"その中で何度も感じてきたのが",{"tag":"br","attrs":{},"children":[]},{"tag":"strong","attrs":{},"children":["「ママが整うと、その幸せは家族にも自然と広がっていく」"]},{"tag":"br","attrs":{},"children":[]},"ということです。",{"tag":"br","attrs":{},"children":[]},"自分を整えることは",{"tag":"br","attrs":{},"children":[]},"自分のためだけではありません。",{"tag":"br","attrs":{},"children":[]},"子どもの声かけが変わったり",{"tag":"br","attrs":{},"children":[]},"家族との関わり方が変わったり。",{"tag":"br","attrs":{},"children":[]},"今までならイライラしていたことも",{"tag":"br","attrs":{},"children":[]},"少し違った角度から見られるようになったり。",{"tag":"br","attrs":{},"children":[]},"そんな小さな変化が積み重なって",{"tag":"br","attrs":{},"children":[]},{"tag":"strong","attrs":{},"children":["家族みんなが、より幸せに過ごせるようになる。"]},{"tag":"br","attrs":{},"children":[]},"それは子育てが一段落したあとも同じです。",{"tag":"br","attrs":{},"children":[]},"仕事、人間関係、これからの人生。",{"tag":"br","attrs":{},"children":[]},"どんなときも",{"tag":"br","attrs":{},"children":[]},"「私は本当はどうしたい？」",{"tag":"br","attrs":{},"children":[]},"と自分に問いかけることが",{"tag":"br","attrs":{},"children":[]},"自分らしく生きるための土台になると考えていいます。",{"tag":"br","attrs":{},"children":[]},{"tag":"br","attrs":{},"children":[]}]}]},{"tag":"p","attrs":{"class":"wp-block-paragraph"},"children":[{"tag":"strong","attrs":{},"children":["はじめての方のお問い合わせ、お申し込みはこちら"]}]},{"tag":"div","attrs":{"class":"wp-block-vk-blocks-button vk_button vk_button-color-custom vk_button-align-left"},"children":[{"tag":"a","attrs":{"href":"https://line.me/R/ti/p/@615ytuyo","class":"vk_button_link btn has-text-color is-style-outline has-vivid-green-cyan-color btn-md","role":"button","aria-pressed":"true","rel":"noopener"},"children":[{"tag":"div","attrs":{"class":"vk_button_link_caption"},"children":[{"tag":"i","attrs":{"class":"fab fa-line vk_button_link_before","aria-hidden":"true"},"children":[]},{"tag":"span","attrs":{"class":"vk_button_link_txt"},"children":["公式LINE"]}]}]}]},{"tag":"div","attrs":{"class":"wp-block-contact-form-7-contact-form-selector"},"chil